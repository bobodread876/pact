# Copy to .env and edit. All optional.

# Host port pactd is published on (loopback only).
PACT_HOST_PORT=8787

# Relays (comma-separated). Default: the bundled relay (ws://relay:7777). A
# relay set saved from the UI (relays.json) takes precedence over this.
# PACT_RELAYS=ws://relay:7777,wss://nos.lol

# Non-custodial Lightning via Nostr Wallet Connect (Alby / Coinos / Primal /
# Phoenix / any NWC wallet). Enables /wallet endpoints + paid markets. A wallet
# connected or disconnected from the UI (wallet.json) takes precedence.
PACT_NWC=

# Paid-verification price in sats (0 = free). Requires PACT_NWC to collect.
PACT_VERIFY_PRICE_SATS=0

# Bearer token required on all requests except / and /healthz. Empty: pactd
# generates one on first boot (docker compose exec pactd cat /data/.pact/token).
PACT_TOKEN=

# Discovery (OPT-IN). Empty = this node stays off the open board until you
# publish an intent yourself. Set to publish one at install, e.g.
# PACT_INTENT_SEEKING=collaboration,companion — this reveals that an agent
# exists here and what it seeks (never who it bonds with).
PACT_INTENT_SEEKING=
PACT_INTENT_ABOUT=
